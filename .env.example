# 로컬 스크립트(scripts/*.py)가 읽는 환경 변수입니다. 이 파일을 .env 로 복사해서 값을 채우세요.
#   cp .env.example .env
# .env 에는 비밀 값이 들어가므로 공유하거나 커밋하지 마세요 (.gitignore 에 들어 있음).
# 값이 빈 줄은 무시되고, 명령줄에서 준 환경 변수가 .env 보다 우선합니다.
# BUCKET_NAME 과 AWS 자격 증명은 필요 없습니다 (로컬 스크립트는 S3 대신 로컬 폴더를 씀).
# Lambda 는 이 파일을 읽지 않습니다. 배포할 때 값은 sam deploy 파라미터로 넣습니다.

# ── 필수: run_local.py (추천 메시지 보내기) ──
# 카카오 디벨로퍼스 앱의 REST API 키 (앱 관리 페이지 > 카카오맵 > 사용 설정이 ON 이어야 함)
# run_local.py --sample 로 샘플 식당만 보낼 때는 비워 둬도 됩니다
KAKAO_REST_API_KEY=
# 디스코드 개발자 포털 > Bot > Reset Token 으로 받은 봇 토큰. 봇 계정이 이 토큰으로 채널에 메시지를 보냅니다
DISCORD_BOT_TOKEN=
# 추천을 보낼 채널 ID (디스코드 개발자 모드 켜고 채널 우클릭 > 채널 ID 복사). 봇이 그 서버에 초대돼 있어야 합니다
DISCORD_CHANNEL_ID=

# ── 저녁 추천: run_local.py --dinner ──
# 저녁 추천을 보낼 채널(오저뭐) ID. 봇이 그 채널에 메시지를 보낼 수 있어야 합니다
DINNER_CHANNEL_ID=
# 선택: 저녁 투표 정원 (비우면 오저뭐를 볼 수 있는 사람 수로 자동), 저녁 식사 자리에서 뺄 분류
# DINNER_VOTER_COUNT=7
# DINNER_EXCLUDE_CATEGORIES=간식,구내식당

# ── 우사기 채널: usagi_bot.py (docker compose 의 usagi) ──
# 사람이 채팅을 보내면 우사기 봇이 우사기 소리로 답할 채널 ID
# 채팅 내용에 맞춰 답하려면 개발자 포털 > Bot > MESSAGE CONTENT INTENT 를 켜고 usagi 를 다시 띄움 (꺼져 있으면 무작위로 답함)
USAGI_CHANNEL_ID=
# 선택: 하치와레 웹훅 주소들, 쉼표로 구분 (채널마다 채널 편집 > 연동 > 웹후크 > 새 웹후크 > 웹후크 URL 복사)
# 번역이 켜져 있을 때(모두가 보는 채널 /하치와레 전체 켜기, 1:1 스레드 /하치와레 번역 켜기, 기본 꺼짐) 우사기 채널 것은 대화 번역,
# 오점뭐·오저뭐 것은 추천·투표 결과 번역,
# 모든 채널 것은 그 채널의 우사기 명령 안내에 씀. 꺼져 있으면 하치와레는 아무 말도 안 함
# 바꾼 뒤에는 docker compose up -d interaction usagi (restart 로는 새 값을 못 읽음)
HACHIWARE_WEBHOOK_URLS=

# ── 필수: serve_local.py (버튼 클릭 처리) ──
# 디스코드 개발자 포털 > General Information > PUBLIC KEY
DISCORD_PUBLIC_KEY=

# ── 선택: 추천 설정 (주석으로 두면 아래 기본값) ──
# 바꾸면 다음 추천부터 반영됩니다. 반경을 넓히거나 중심을 옮기거나 빼던 분류를 다시 넣으면 식당 목록을 자동으로 다시 모읍니다.
# CENTER_LAT=37.497952
# CENTER_LNG=127.027619
# RADIUS_M=800
# PICK_COUNT=5
# CACHE_DAYS=7
# SEARCH_PREFIX=강남역
# EXCLUDE_CATEGORIES=술집,간식

# ── 선택: 투표 정원 ──
# 정원만큼 투표하면 자동으로 끝납니다. 비우거나 0 이면 채널을 볼 수 있는 사람 수(봇 제외)를 자동으로 셉니다
# (개발자 포털 Bot 탭의 SERVER MEMBERS INTENT 필요). 셀 수 없으면 '투표 종료' 버튼으로만 끝납니다.
# VOTER_COUNT=7

# ── 선택: 로컬 저장 폴더 (기본 .local-s3/) ──
# LOCAL_S3_DIR=
